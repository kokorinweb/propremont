# ── Заявки в Telegram ────────────────────────────────────────────
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA...
# Чат, куда падают заявки (личка мастера или рабочая группа).
# Узнать id: напишите боту и откройте https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=-1001234567890

# ── Сайт ─────────────────────────────────────────────────────────
# Публичный адрес: нужен для canonical, Open Graph и разметки для поисковиков.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
